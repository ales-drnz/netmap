{
  "name": "netmap",
  "version": "0.1.0",
  "description": "A live map and dashboard for your ZeroTier network, for ZTNET.",
  "license": "BSD-3-Clause",
  "author": "Alessandro Di Ronza",
  "repository": {
    "type": "git",
    "url": "https://github.com/ales-drnz/netmap.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx mock/dev.ts",
    "dev:web": "cd web && vite dev",
    "build:web": "cd web && vite build",
    "build:server": "node scripts/build-server.mjs",
    "build": "npm run build:web && npm run build:server",
    "check": "tsc -p server && cd web && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "biome check server scripts mock shared web/src/lib/*.ts web/svelte.config.js web/vite.config.ts biome.json",
    "test": "vitest run",
    "start": "node dist/server.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@hono/node-server": "^2.1.4",
    "hono": "^4.13.13",
    "zod": "^4.6.6"
  }
}
